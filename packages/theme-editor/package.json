{
	"name": "@applied-design-systems/theme-editor",
	"version": "0.1.0",
	"description": "Create, edit, preview, and save an Applied Design Systems contract (DESIGN.md + design-tokens.css).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zipang/applied-design-systems.git",
		"directory": "packages/theme-editor"
	},
	"type": "module",
	"bin": {
		"theme-editor": "./src/server.tsx"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"index.html",
		"DESIGN.md",
		"design-tokens.css",
		"tsconfig.json"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"keywords": [
		"design-system",
		"design-tokens",
		"design.md",
		"theme-editor",
		"radix-ui",
		"bun"
	],
	"scripts": {
		"dev": "bun --hot src/server.tsx",
		"start": "bun src/server.tsx",
		"typecheck": "bun --check"
	},
	"dependencies": {
		"@applied-design-systems/design-tokens": "workspace:*",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tabs": "^1.1.20",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0"
	}
}
